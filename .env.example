NEXT_PUBLIC_PRIVY_APP_ID=your-privy-app-id
NEXT_PUBLIC_NFTMAIL_URL=https://nftmail.box

# === Worker auth (server-side only — required for /api/tray/* routes) ===
# Must match the secrets configured on worker.nftmail.box. Same values used
# by the nftmailbox-netlify deployment.
WORKER_SECRET=
WEBHOOK_SECRET=
NFTMAIL_WEBHOOK_SECRET=

# === Chonk backpack viewer (tokenbound.org replacement) ===
# Optional. Speeds up Chonk/TBA NFT enumeration via Alchemy's NFT API.
# Falls back to Base RPC Transfer-event scanning if unset (slower, still works).
# Free tier at https://dashboard.alchemy.com is plenty.
ALCHEMY_API_KEY=

